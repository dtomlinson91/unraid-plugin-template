<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
  <!ENTITY name       "@NAME@">
  <!ENTITY title      "@TITLE@">
  <!ENTITY author     "dtomlinson">
  <!ENTITY version    "@PLUGIN_VERSION@">
  <!ENTITY upstream   "@VERSION@">
  <!ENTITY sources    "@SOURCES@">
  <!ENTITY gitURL     "https://github.com/dtomlinson91/&name;">
  <!ENTITY pluginURL  "&gitURL;/raw/main/&name;.plg">
  <!ENTITY releaseURL "&gitURL;/releases/download/&version;">
  <!ENTITY plugin     "/boot/config/plugins/&name;">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;" support="&gitURL;" min="@MIN@">

<CHANGES>
@CHANGES@
</CHANGES>

<FILE Run="/bin/bash">
<INLINE>
v=$(sed -nE 's/^version="([^"]+)".*/\1/p' /etc/unraid-version)
case $v in
@GUARD@
  *)
    echo "*** &title; has no package for Unraid $v. It supports Unraid @SUPPORTED@. ***"
    exit 1
    ;;
esac
</INLINE>
</FILE>

@FILES@
<FILE Run="/bin/bash">
<INLINE>
check() {
  if ! echo "$2  &plugin;/$1" | sha256sum --check --status; then
    echo "*** the sha256 of $1 does not match - removing the file ***"
    rm -f "&plugin;/$1"
    exit 1
  fi
  echo "*** the sha256 of $1 is correct ***"
}
@CHECKS@
v=$(sed -nE 's/^version="([^"]+)".*/\1/p' /etc/unraid-version)
case $v in
@SELECT@
esac
for f in /var/log/packages/&name;-*; do
  [ -e "$f" ] || continue
  p=$(basename "$f")
  [ "$p" = "$package" ] || removepkg "$p"
done
find "&plugin;" -maxdepth 1 -type f -name "&name;-*" @KEEP@ -print -delete
upgradepkg --install-new "&plugin;/$package.txz"
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
for f in /var/log/packages/&name;-*; do
  [ -e "$f" ] || continue
  removepkg "$(basename "$f")"
done
rm -rf "&plugin;" "/usr/local/emhttp/plugins/&name;"
echo "*** removed &title; ***"
</INLINE>
</FILE>
</PLUGIN>
